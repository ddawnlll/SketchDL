c_sources = ["vendor/sqlite/sqlite3.c", "vendor/proc.c"];
c_defines = ["SQLITE_THREADSAFE=1", "SQLITE_DEFAULT_MEMSTATUS=0", "SQLITE_DEFAULT_FOREIGN_KEYS=1", "SQLITE_DQS=0", "SQLITE_OMIT_LOAD_EXTENSION", "SQLITE_OMIT_DEPRECATED", "SQLITE_USE_URI=0", "SQLITE_ENABLE_FTS5"];
c_flags_cc = ["-O2"];
output = "sketchdl";
